# Backend environment variables (rename to .env and fill with real values)

# Express server
PORT=8080

# IOTA node URL (local testnet / fullnode)
IOTA_NODE_URL=http://127.0.0.1:14265

# Smart contract identifiers (use the ones deployed to your network)
PACKAGE_ID=0x9bf6b9515e995cb7cf2ee08a7a1e956454a9ab723d5b766e75a0575654df1579
REGISTRY_ID=0x6bace8e70cf7a7e19b60c35d51bc7a2b01a92d0c748d8cc9c9358072bc3cb56f

# Notarization package ID (deploy the notarization-move package)
NOTARIZATION_PACKAGE_ID=0x...

# Server identity key to sign notarization transactions
PRIVATE_KEY=iotaprivkey1...
